  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bem vindo ao Last Orbit!\n\nEnfrente hordas de inimigos cada vez mais
    fortes e tente sobreviver o m\xE1ximo de tempo poss\xEDvel. Derrote inimigos,
    desbloqueie novas armas e use diferentes estrat\xE9gias para continuar vivo.\n\nA
    arma inicial. Dispara automaticamente na dire\xE7\xE3o em que voc\xEA est\xE1
    mirando.\n\nA P\xE1 gira ao redor do jogador e causa dano nos inimigos que entram
    em seu alcance.\n\nA Foice lan\xE7ada na dire\xE7\xE3o da mira, avan\xE7ando
    at\xE9 atingir um inimigo ou chegar ao seu limite de dist\xE2ncia. Depois, permanece
    girando e causando dano aos inimigos.\n\nO Forcado \xE9 lan\xE7ado e viaja continuamente
    pela arena. Ao encontrar as paredes, ela rebate e muda sua trajet\xF3ria, causando
    dano aos inimigos que encontrar pelo caminho."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
